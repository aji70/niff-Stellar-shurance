# Public (browser-safe) variables — validated in lib/env.ts
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet
# Comma-separated key:boolean list, e.g. NEXT_PUBLIC_FEATURE_FLAGS=swap:true,pool:false
NEXT_PUBLIC_FEATURE_FLAGS=

# Server-only variables — validated in lib/env.server.ts (never expose to the browser)
API_SECRET_KEY=replace-me
DATABASE_URL=postgres://user:password@localhost:5432/app
